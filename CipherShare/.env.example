# ──────────────────────────────────────────────
# CipherShare — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to backend/.env and fill in real values.
# NEVER commit the .env file to version control.

# Application
APP_NAME=CipherShare
APP_VERSION=0.1.0
DEBUG=false

# Database (SQLite for local development)
DATABASE_URL=sqlite:///./ciphershare.db

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# ── Authentication ───────────────────────────
# Generate a secure secret with PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The application will refuse to start if this is empty or a placeholder.
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
